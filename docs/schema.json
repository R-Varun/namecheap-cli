    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Namecheap CLI result",
      "type": "object",
      "required": [
        "schema_version",
        "ok",
        "command"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "ok": {
          "type": "boolean"
        },
        "command": {
          "type": "string"
        },
        "data": {
          "type": "object"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "details",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object"
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ok": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "data",
              "warnings"
            ]
          },
          "else": {
            "required": [
              "error"
            ]
          }
        }
      ]
    },
    "zone_file_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Namecheap zone",
      "type": "object",
      "required": [
        "domain",
        "hosts"
      ],
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": "string"
        },
        "email_type": {
          "enum": [
            "MX",
            "MXE",
            "FWD",
            "OX",
            null
          ]
        },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "type",
              "address"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "A",
                  "AAAA",
                  "ALIAS",
                  "CNAME",
                  "MX",
                  "MXE",
                  "NS",
                  "TXT",
                  "URL",
                  "URL301",
                  "FRAME"
                ]
              },
              "address": {
                "type": "string",
                "minLength": 1
              },
              "ttl": {
                "type": "integer",
                "minimum": 60,
                "maximum": 60000
              },
              "mxpref": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            },
            "allOf": [
              {
                "if": {
                  "not": {
                    "properties": {
                      "type": {
                        "const": "MX"
                      }
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": [
                      "mxpref"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
